        "--diagnostic-width=209",
        "--crate-type",
        "lib",
        "--emit=dep-info,metadata,link",
        "-C",
        "embed-bitcode=no",
        "-C",
        "debuginfo=2",
        "--check-cfg",
        "cfg(docsrs,test)",
        "--check-cfg",
        "cfg(feature, values(\"trace_tokenizer\"))",
        "-C",
        "metadata=2f3eb3244bc8bd86",
        "-C",
        "extra-filename=-956da530969691aa",
        "--out-dir",
