command123: Command {
    program: "rustc",
    args: [
        "rustc",
        "-",
        "--crate-name",
        "___",
        "--print=file-names",
        "--crate-type",
        "bin",
        "--crate-type",
        "rlib",
        "--crate-type",
        "dylib",
        "--crate-type",
        "cdylib",
        "--crate-type",
        "staticlib",
        "--crate-type",
        "proc-macro",
        "--print=sysroot",
        "--print=split-debuginfo",
        "--print=crate-name",
        "--print=cfg",
        "-Wwarnings",
    ],
    env: CommandEnv {
        clear: false,
        vars: {
            "RUSTC_LOG": None,
        },
    },
    create_pidfd: false,
}